<?xml version="1.0" encoding="utf-8"?>
<chart id="74">
  <P Name="name">航路跟踪/MATLAB Function1</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">74</P>
  <P Name="ssIdHighWaterMark">24</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.001</P>
  <P Name="chartFileNumber">6</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">dy_dydot_subsystem</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">74</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [dy, dy_dot, DTG] = dy_dydot_subsystem(fly_type, prev_pt, next_pt, coc_pt, xyz_g, Vxyz_g)

    if fly_type == 1
        [dy, dy_dot, DTG] = line_calculation(prev_pt, next_pt, xyz_g, Vxyz_g);
    elseif fly_type == 2
        [dy, dy_dot] = dy_dydot_circle(coc_pt, xyz_g, prev_pt, Vxyz_g);
        DTG = dtg_circle(next_pt, xyz_g, coc_pt);
    else
        [dy, dy_dot, DTG] = line_calculation(prev_pt, next_pt, xyz_g, Vxyz_g);
    end

end

function [dy_line, dy_dot_line, DTG_line] = line_calculation(prev_pt, next_pt, current_pt, Vxyz_g)
%line_calculation 直线段侧偏距、侧偏距变化率、剩余距离计算

    % 提取坐标
    x1 = prev_pt(1); y1 = prev_pt(2);
    x2 = next_pt(1); y2 = next_pt(2);
    x  = current_pt(1); y = current_pt(2);
    vx = Vxyz_g(1); vy = Vxyz_g(2);

    % === 计算路径方向角 ===
    dx = x2 - x1;
    dy = y2 - y1;

    if dx &gt; 0
        true_psi = atan2(dy, dx);
    elseif dx &lt; 0
        true_psi = pi - atan2(dy, abs(dx));
    else
        if dy &gt; 0
            true_psi = pi/2;
        elseif dy &lt; 0
            true_psi = 3*pi/2;
        else
            true_psi = 0;
        end
    end

    % === 构建旋转矩阵并转换到路径坐标系 ===
    % 路径坐标系: 第1轴为侧偏方向, 第2轴为沿航方向
    c = cos(true_psi);
    s = sin(true_psi);
    T = [c, -s; s, c];              % 旋转矩阵

    V_prev_next = T * [y2 - y1; x2 - x1];   % 路径在路径坐标系中 = [0; |P|]
    V_prev_curr = T * [y - y1;  x - x1];    % 当前位置在路径坐标系中 = [dy; along]

    % === 侧偏距 dy  ===

    dy_line = V_prev_curr(1);

    % === 剩余距离 DTG ===
    norm_next = norm(V_prev_next);
    if norm_next &gt; 1e-10
        L_temp = dot(V_prev_next, V_prev_curr) / norm_next;  % 沿航迹投影
        DTG_line = norm_next - L_temp;
    else
        DTG_line = 0;
    end

    % === 侧偏距变化率 dy_dot ===

    dy_dot_line = -vx * s + vy * c;

end
function DTG = dtg_circle(next_pt, current_pt, coc_pt)
%dtg_circle 圆弧段剩余弧长计算
    % 提取坐标
    x_cur  = current_pt(1); y_cur  = current_pt(2);
    x_next = next_pt(1);    y_next = next_pt(2);
    x0 = coc_pt(1);         y0 = coc_pt(2);
    radius = coc_pt(5);

    % 当前位置-&gt;圆心向量、目标点-&gt;圆心向量
    O_cur = [x_cur - x0,  y_cur - y0];
    O_nex = [x_next - x0, y_next - y0];

    % 两向量夹角 (防止acos数值越界)
    cos_angle = dot(O_cur, O_nex) / (norm(O_cur) * norm(O_nex) + eps);
    cos_angle = min(max(cos_angle, -1), 1);

    % 弧长 = 半径 x 夹角
    DTG = radius * acos(cos_angle);

end
function [dy_circle, dy_dot_circle] = dy_dydot_circle(coc_pt, current_pt, prev_pt, Vxyz_g)

    % 提取数据
    x0 = coc_pt(1);      y0 = coc_pt(2);
    radius = coc_pt(5);
    x_cur = current_pt(1); y_cur = current_pt(2);
    vx = Vxyz_g(1); vy = Vxyz_g(2);

    dir_type = prev_pt(5);   % 1=右转, 2=左转

    % 当前位置到圆心的距离
    L_O = norm([x_cur - x0, y_cur - y0]);

    % 径向向量 (圆心-&gt;飞机) 和径向单位向量
    if L_O &gt; 1e-10
        radial_unit = [x_cur - x0, y_cur - y0] / L_O;
    else
        radial_unit = [0, 0];
    end

    % 速度在径向方向的投影: cos_angle2 = dot(v, radial) / (|v| * L)
    v_norm = sqrt(vx^2 + vy^2);
    if v_norm &gt; 1e-10
        cos_angle2 = (vx * radial_unit(1) + vy * radial_unit(2)) / v_norm;
    else
        cos_angle2 = 0;
    end

    % 根据转向类型计算 dy 和 dy_dot
    if dir_type == 1        % 右转: 圆内为正(偏右)
        dy_circle = -radius + L_O;
        dy_dot_circle = v_norm * cos_angle2;   % 径向向外速度(朝向路径)
    elseif dir_type == 2    % 左转: 圆外为正(偏右)
        dy_circle = -L_O + radius;
        dy_dot_circle = -v_norm * cos_angle2;  % 径向向内速度(朝向路径)
    else
        dy_circle = 0;
        dy_dot_circle = 0;
    end

end
</P>
      </eml>
    </state>

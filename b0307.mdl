<?xml version="1.0" encoding="utf-8"?>
<chart id="105">
  <P Name="name">航路跟踪/MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">105</P>
  <P Name="ssIdHighWaterMark">17</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.001</P>
  <P Name="chartFileNumber">12</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fly_phase</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">105</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [fly_phase, fly_type, prev_pt, next_pt, coc_pt] = fly_phase(dy, DTG, time, fly_pt, xyz_g)

xyz_g = xyz_g(:)&apos;;  % 统一转为行向量 [x, y, z]

persistent fly_phase_temp fly_type_temp coc_pt_temp prev_pt_temp next_pt_temp arc_entered
if isempty(fly_phase_temp)
    fly_phase_temp = 1;
    arc_entered = false;
    % 初始化数据提取（调用下面定义的子函数）
    [fly_type_temp, prev_pt_temp, next_pt_temp, coc_pt_temp, fly_phase_temp] = ...
        update_segment_data(fly_pt, fly_phase_temp);
end

has_crossed = false;

if time &gt; 0.1 % 稍微给一点初始化时间
    if fly_type_temp == 1
        % --- 直线段切换逻辑 ---
        seg_vec = next_pt_temp(1:3) - prev_pt_temp(1:3);
        seg_len = norm(seg_vec);
        if seg_len &gt; 1e-3
            seg_dir = seg_vec / seg_len;
            curr_vec = xyz_g - prev_pt_temp(1:3);
            along = dot(curr_vec, seg_dir);
            % 只要投影距离超过总长，就切换
            has_crossed = (along &gt;= seg_len);
        else
            has_crossed = true; % 长度太短直接跳过
        end
        arc_entered = false;

    elseif fly_type_temp == 2
        % --- 圆弧段切换逻辑 ---
        x0 = coc_pt_temp(1); y0 = coc_pt_temp(2);
        radius = coc_pt_temp(5);
        dir_type = prev_pt_temp(5); % 1=右转(CW), 2=左转(CCW)
        
        dist_to_center = norm(xyz_g(1:2) - [x0, y0]);
        
        % 判断是否进入有效圆弧跟踪区（防止切入前的误判）
        if ~arc_entered
            % 距离圆心误差在30%以内或距离目标点较近时，锁定圆弧逻辑
            if abs(dist_to_center - radius) &lt; radius * 0.3 || DTG &lt; 50
                arc_entered = true;
            end
        end

        if arc_entered
            theta_entry = atan2(prev_pt_temp(2) - y0, prev_pt_temp(1) - x0);
            theta_exit  = atan2(next_pt_temp(2) - y0, next_pt_temp(1) - x0);
            theta_curr  = atan2(xyz_g(2) - y0, xyz_g(1) - x0);

            if dir_type == 1 % 右转，顺时针，角度递减
                total_sweep = mod(theta_entry - theta_exit, 2*pi);
                sweep = mod(theta_entry - theta_curr, 2*pi);
            else % 左转，逆时针，角度递增
                total_sweep = mod(theta_exit - theta_entry, 2*pi);
                sweep = mod(theta_curr - theta_entry, 2*pi);
            end
            % 扫过角度达到总角度则切换
            has_crossed = (sweep &gt;= total_sweep - 0.01); % 留一点裕量
        end
    end
end

% --- 执行切换逻辑 ---
if has_crossed
    % 指针先加1
    fly_phase_temp = fly_phase_temp + 1;
    
    % [核心修复] 自动跳过重复点或极近点
    while fly_phase_temp + 1 &lt; size(fly_pt, 1)
        dist_to_next = norm(fly_pt(fly_phase_temp, 1:2) - fly_pt(fly_phase_temp+1, 1:2));
        % 如果两行点坐标太近（&lt; 0.5m），说明是冗余点，直接继续跳
        if dist_to_next &lt; 0.5
            fly_phase_temp = fly_phase_temp + 1;
        else
            break;
        end
    end
    
    % 更新段数据
    if fly_phase_temp + 1 &lt;= size(fly_pt, 1)
        [fly_type_temp, prev_pt_temp, next_pt_temp, coc_pt_temp, fly_phase_temp] = ...
            update_segment_data(fly_pt, fly_phase_temp);
        arc_entered = false;
    end
end

% 输出赋值
prev_pt = prev_pt_temp;
next_pt = next_pt_temp;
coc_pt = coc_pt_temp;
fly_type = fly_type_temp;
fly_phase = fly_phase_temp;

end

% --- 辅助函数：根据当前索引提取下一段的完整信息 ---
function [type, p_pt, n_pt, c_pt, new_idx] = update_segment_data(fly_pt, idx)
    new_idx = idx;
    p_pt = fly_pt(new_idx, :);
    type = p_pt(4);
    
    % 默认目标点是下一行
    n_pt = fly_pt(new_idx + 1, :);
    c_pt = [0 0 0 1 0]; % 直线段默认圆心
    
    % 如果当前段是圆弧，且下一行(new_idx+1)是圆心定义行
    % 判断标准：Type=2 且 Info(第5列) 不是 1 或 2 (而是半径)
    if type == 2
        cand_n_pt = fly_pt(new_idx + 1, :);
        if cand_n_pt(4) == 2 &amp;&amp; cand_n_pt(5) ~= 1 &amp;&amp; cand_n_pt(5) ~= 2
            % 确认 new_idx+1 是圆心行
            c_pt = cand_n_pt;
            % 真正的目标点应该是圆心行的下一行
            if new_idx + 2 &lt;= size(fly_pt, 1)
                new_idx = new_idx + 1; % 跳过圆心行
                n_pt = fly_pt(new_idx + 1, :);
            end
        end
    end
end</P>
      </eml>
    </state>
    <data SSID="11" name="dy">
